# TypeSafe System One. Export TYPESAFE_API_KEY or set DSPY_API_KEY.
DSPY_MODEL=typesafe:jev-latest
DSPY_API_KEY=
DSPY_API_BASE=
DSPY_LM_KWARGS={}
DSPY_TRACK_USAGE=true

# Standalone Tika endpoint. Compose supplies its own service URL.
PHISHCHECK_TIKA_URL=
# PHISHCHECK_DATABASE_PATH=/path/to/history.sqlite
# PHISHCHECK_PORT=8000

# Both a tracking URI and explicit enablement are required for MLflow tracing.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=phishcheck
MLFLOW_ENABLED=false
