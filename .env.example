# Jev model. Export TYPESAFE_API_KEY or set DSPY_API_KEY below.
DSPY_MODEL=typesafe:jev-latest
DSPY_API_KEY=
DSPY_API_BASE=
DSPY_LM_KWARGS={}
DSPY_TRACK_USAGE=true

# Empty URI disables tracing. Set false to disable even with a URI.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=emailscan
# MLFLOW_ENABLED=false
